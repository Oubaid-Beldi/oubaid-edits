---
import { getCollection } from "astro:content";

const stats = (await getCollection("stats")).sort(
  (a, b) => (a.data.sortOrder ?? Infinity) - (b.data.sortOrder ?? Infinity)
);

// Splits a value like "3.2M" or "48h" into a leading numeric part (rendered
// in the lighter accent color, matching the mockup's two-tone stat numbers)
// and a trailing suffix — mirrors Hero's **accent** marker trick: derive the
// visual split from the string instead of adding a second schema field.
function splitValue(value: string): [string, string] {
  const match = value.match(/^([\d.,]+)(.*)$/);
  return match ? [match[1], match[2]] : [value, ""];
}
---

<section>
  <div class="wrap">
    <div class="stats-band">
      {stats.map((stat) => {
        const [num, suffix] = splitValue(stat.data.value);
        return (
          <div>
            <div class="stat-num"><span>{num}</span>{suffix}</div>
            {stat.data.label && <div class="stat-lbl">{stat.data.label}</div>}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .stats-band {
    background: var(--blue-900);
    border-radius: 24px;
    padding: 52px 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    color: #fff;
  }
  .stat-num {
    font-size: 38px;
    font-weight: 800;
    color: #fff;
  }
  .stat-num span {
    color: #7fa6f6;
  }
  .stat-lbl {
    font-size: 13.5px;
    color: #b7c4e0;
    margin-top: 6px;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .stats-band {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
