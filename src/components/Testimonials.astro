---
import { getCollection } from "astro:content";

const testimonials = (await getCollection("testimonials")).sort(
  (a, b) => (a.data.sortOrder ?? Infinity) - (b.data.sortOrder ?? Infinity)
);
---

<section id="testimonials">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Client Testimonials</div>
      <h2>What clients say</h2>
    </div>
    <div class="test-grid">
      {testimonials.map((t) => (
        <div class="test-card">
          {t.data.rating && (
            <div class="stars" role="img" aria-label={`${t.data.rating} out of 5 stars`}>
              <span aria-hidden="true">{"★".repeat(t.data.rating) + "☆".repeat(5 - t.data.rating)}</span>
            </div>
          )}
          <p class="test-quote">"{t.data.quote}"</p>
          <div class="test-person">
            <div class="avatar" aria-hidden="true"></div>
            <div>
              <div class="p-name">{t.data.name ?? "Anonymous Client"}</div>
              {t.data.role && <div class="p-role">{t.data.role}</div>}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .test-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .test-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .stars {
    color: var(--blue-600);
    font-size: 15px;
    margin-bottom: 14px;
    letter-spacing: 2px;
  }
  .test-quote {
    font-size: 14.5px;
    color: var(--ink);
    margin: 0 0 20px;
  }
  .test-person {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--blue-100);
  }
  .p-name {
    font-weight: 700;
    font-size: 13.5px;
  }
  .p-role {
    font-size: 12px;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .test-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .test-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
