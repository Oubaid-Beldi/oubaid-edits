---
import { getCollection } from "astro:content";

const steps = (await getCollection("process")).sort(
  (a, b) => (a.data.sortOrder ?? Infinity) - (b.data.sortOrder ?? Infinity)
);
---

<section id="process">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">How I Work</div>
      <h2>A simple, predictable process</h2>
    </div>
    <div class="process-strip">
      {steps.map((step, i) => (
        <div class="process-card">
          <div class="process-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</div>
          <h3>{step.data.title}</h3>
          {step.data.description && <p>{step.data.description}</p>}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .process-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px 22px;
    position: relative;
  }
  .process-num {
    font-size: 34px;
    font-weight: 800;
    color: var(--blue-100);
    position: absolute;
    top: 16px;
    right: 18px;
  }
  .process-card h3 {
    font-size: 16.5px;
    margin: 8px 0 8px;
    font-weight: 800;
  }
  .process-card p {
    font-size: 14px;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 900px) {
    .process-strip {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .process-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
