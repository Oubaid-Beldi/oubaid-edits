---
import { getCollection } from "astro:content";

// A Question with no Answer isn't complete enough to show — this is a
// build-time convention, not a Sveltia-enforced required field (Answer is
// deliberately optional per the Data model, e.g. for a drafted-but-unwritten
// entry).
const faqs = (await getCollection("faq"))
  .filter((entry) => entry.data.answer)
  .sort((a, b) => (a.data.sortOrder ?? Infinity) - (b.data.sortOrder ?? Infinity));
---

<section id="faq">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">FAQ</div>
      <h2>Good to know</h2>
    </div>
    <div class="faq-list">
      {faqs.map((item, i) => (
        <div class:list={["faq-item", { open: i === 0 }]}>
          <button class="faq-q">{item.data.question} <span class="plus">+</span></button>
          <div class="faq-a">{item.data.answer}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    max-width: 760px;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-q {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    padding: 20px 0;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink);
    font-family: inherit;
  }
  .faq-q .plus {
    font-size: 20px;
    color: var(--blue-600);
    transition: transform 0.2s;
  }
  .faq-item.open .faq-q .plus {
    transform: rotate(45deg);
  }
  .faq-a {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.25s ease;
    font-size: 14.5px;
    color: var(--ink-soft);
  }
  .faq-item.open .faq-a {
    max-height: 200px;
    padding-bottom: 20px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq-q").forEach((q) => {
    q.addEventListener("click", () => {
      const item = q.parentElement;
      const wasOpen = item?.classList.contains("open");
      document.querySelectorAll(".faq-item").forEach((i) => i.classList.remove("open"));
      if (!wasOpen) item?.classList.add("open");
    });
  });
</script>
