---
const options = [
  "What do you need help with?",
  "Cosmetic Dentistry content",
  "Meta Ads",
  "Talking Head / brand film",
  "Podcast editing",
  "Testimonial video",
  "Something else",
];
---

<section id="contact">
  <div class="wrap">
    <div class="contact-grid">
      <div>
        <div class="eyebrow">Contact</div>
        <h2>Let's talk about your project</h2>
        <p class="section-sub" style="margin-bottom:28px;">
          Fill out the form or reach out directly — I usually reply within a day.
        </p>
        <div class="contact-info-item">
          <div class="ci-icon">@</div>
          <div>
            <div class="ci-label">Email</div>
            <div class="ci-val">hello@oubaidedits.com</div>
          </div>
        </div>
        <div class="contact-info-item">
          <div class="ci-icon">in</div>
          <div>
            <div class="ci-label">Instagram</div>
            <div class="ci-val">@oubaidedits</div>
          </div>
        </div>
        <div class="contact-info-item">
          <div class="ci-icon">⏱</div>
          <div>
            <div class="ci-label">Response time</div>
            <div class="ci-val">Within 24 hours</div>
          </div>
        </div>
      </div>
      <form id="contactForm">
        <div class="form-row">
          <input type="text" placeholder="Your name" required />
          <input type="email" placeholder="Email address" required />
        </div>
        <select>
          {options.map((opt) => <option>{opt}</option>)}
        </select>
        <textarea placeholder="Tell me a bit about your project..."></textarea>
        <button class="submit-btn" type="submit">Send message</button>
        <div class="form-note" id="formMsg1" style="display:none;color:var(--blue-600);font-weight:700;">
          ✓ Message sent (mockup only — connects to Formspree in the real build).
        </div>
        <div class="form-note">Powered by Formspree · no backend required.</div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 50px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 50px;
  }
  .contact-grid h2 {
    margin-top: 0;
  }
  .contact-info-item {
    display: flex;
    gap: 14px;
    margin-bottom: 22px;
  }
  .ci-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-btn);
    background: var(--blue-100);
    color: var(--blue-700);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    flex-shrink: 0;
  }
  .ci-label {
    font-size: 12px;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .ci-val {
    font-weight: 700;
    font-size: 14.5px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  input,
  textarea,
  select {
    border: 1.5px solid var(--line);
    border-radius: var(--radius-btn);
    padding: 13px 14px;
    font-size: 14.5px;
    font-family: inherit;
    background: var(--blue-50);
  }
  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: var(--blue-600);
  }
  textarea {
    min-height: 110px;
    resize: vertical;
  }
  .submit-btn {
    background: var(--blue-600);
    color: #fff;
    border: none;
    padding: 14px;
    border-radius: var(--radius-btn);
    font-weight: 800;
    font-size: 15px;
    cursor: pointer;
  }
  .form-note {
    font-size: 12px;
    color: var(--ink-soft);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById("contactForm") as HTMLFormElement | null;
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    form.reset();
    const msg = document.getElementById("formMsg1");
    if (msg) msg.style.display = "block";
  });
</script>
