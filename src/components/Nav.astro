---
const links = [
  { href: "#work", label: "Work" },
  { href: "#process", label: "Process" },
  { href: "#testimonials", label: "Testimonials" },
  { href: "#faq", label: "FAQ" },
];
---

<header>
  <div class="wrap nav">
    <div class="logo"><span class="dot"></span> Oubaid Edits</div>
    <nav>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" title="Toggle light/dark mode" aria-label="Toggle light/dark mode">
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
        </svg>
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
      <a href="#contact" class="cta-btn">Get in touch</a>
      <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNavPanel">☰</button>
    </div>
  </div>
</header>

<div id="mobileNavPanel" class="mobile-nav-panel">
  <ul>
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</div>

<style>
  header {
    position: sticky;
    top: 34px;
    z-index: 100;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .logo {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo .dot {
    width: 9px;
    height: 9px;
    background: var(--blue-600);
    border-radius: 2px;
    transform: rotate(45deg);
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }
  nav ul a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-soft);
    transition: color 0.15s;
  }
  nav ul a:hover {
    color: var(--blue-600);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .theme-toggle {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--line);
    background: var(--white);
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s, color 0.15s, background 0.25s ease;
  }
  .theme-toggle:hover {
    border-color: var(--blue-600);
    color: var(--blue-600);
  }
  .theme-toggle .icon-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .theme-toggle .icon-sun {
    display: block;
  }
  .cta-btn {
    background: var(--blue-600);
    color: #fff;
    padding: 11px 20px;
    border-radius: var(--radius-btn);
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 6px 16px rgba(26, 86, 219, 0.25);
    transition: transform 0.15s, box-shadow 0.15s;
    white-space: nowrap;
  }
  .cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(26, 86, 219, 0.35);
  }
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
    color: var(--ink);
  }
  .mobile-nav-panel {
    display: none;
  }

  @media (max-width: 900px) {
    nav ul {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .mobile-nav-panel.open {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: fixed;
      inset: 0;
      z-index: 99;
      background: var(--paper);
      padding: 130px 28px 24px;
      overflow-y: auto;
    }
    .mobile-nav-panel ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .mobile-nav-panel a {
      display: block;
      padding: 12px 0;
      font-size: 17px;
      font-weight: 700;
      color: var(--ink);
    }
  }

  @media (max-width: 420px) {
    .logo {
      font-size: 16px;
    }
    .cta-btn {
      padding: 9px 14px;
      font-size: 13px;
    }
    .nav-actions {
      gap: 8px;
    }
    .theme-toggle {
      width: 34px;
      height: 34px;
    }
    .theme-toggle svg {
      width: 15px;
      height: 15px;
    }
  }
</style>

<script>
  const panel = document.getElementById("mobileNavPanel");
  const toggle = document.querySelector<HTMLButtonElement>(".mobile-toggle");

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      panel.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });

  const themeToggle = document.getElementById("themeToggle");
  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.getAttribute("data-theme") === "dark";
    const next = isDark ? "light" : "dark";
    if (next === "dark") {
      document.documentElement.setAttribute("data-theme", "dark");
    } else {
      document.documentElement.removeAttribute("data-theme");
    }
    try {
      localStorage.setItem("theme", next);
    } catch (e) {}
  });
</script>
