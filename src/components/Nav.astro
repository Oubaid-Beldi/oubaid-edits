---
const links = [
  { href: "#work", label: "Work" },
  { href: "#process", label: "Process" },
  { href: "#testimonials", label: "Testimonials" },
  { href: "#faq", label: "FAQ" },
];
---

<header>
  <div class="wrap nav">
    <div class="logo"><span class="dot"></span> Oubaid Edits</div>
    <nav>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="#contact" class="cta-btn">Get in touch</a>
    <button class="mobile-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNavPanel">☰</button>
  </div>
</header>

<div id="mobileNavPanel" class="mobile-nav-panel">
  <ul>
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</div>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 248, 251, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .logo {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo .dot {
    width: 9px;
    height: 9px;
    background: var(--blue-600);
    border-radius: 2px;
    transform: rotate(45deg);
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
  }
  nav ul a {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--ink-soft);
    transition: color 0.15s;
  }
  nav ul a:hover {
    color: var(--blue-600);
  }
  .cta-btn {
    background: var(--blue-600);
    color: #fff;
    padding: 11px 20px;
    border-radius: var(--radius-btn);
    font-weight: 700;
    font-size: 14px;
    box-shadow: 0 6px 16px rgba(26, 86, 219, 0.25);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(26, 86, 219, 0.35);
  }
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 22px;
    cursor: pointer;
  }
  .mobile-nav-panel {
    display: none;
  }

  @media (max-width: 900px) {
    nav ul {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .mobile-nav-panel.open {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: fixed;
      inset: 0;
      z-index: 99;
      background: var(--paper);
      padding: 96px 28px 24px;
      overflow-y: auto;
    }
    .mobile-nav-panel ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .mobile-nav-panel a {
      display: block;
      padding: 12px 0;
      font-size: 17px;
      font-weight: 700;
      color: var(--ink);
    }
  }

  @media (max-width: 420px) {
    .logo {
      font-size: 16px;
    }
    .cta-btn {
      padding: 9px 14px;
      font-size: 13px;
    }
  }
</style>

<script>
  const panel = document.getElementById("mobileNavPanel");
  const toggle = document.querySelector<HTMLButtonElement>(".mobile-toggle");

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!isOpen));
  });

  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      panel.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
